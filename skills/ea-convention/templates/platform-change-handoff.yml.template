# Canonical portable SA-to-Platform requested-change contract for one Workstream.
# Runtime progress, deployment state, gates, incidents, and realization evidence
# do not belong in this artifact.
spec_name: platform-change-handoff
spec_version: "1.0.0"
workstream_id: <workstream-id>
initiative_id: <initiative-id>
solution_design_ref:
  ref_version: v2
  artifact_id: <solution-design-artifact-id>
  version: <solution-design-version>
  repository_url: <https://github.com/org/solution-repo>
  repository_entrypoint: <SOLUTION.md>
  artifact_path: <architecture/solution/architecture-design.yml>
  commit_sha: <full-40-or-64-character-commit>
  digest: <sha256:64-hex-digest>
target:
  kind: platform
  platform_id: <platform-id>
  baseline_state: <existing|not_materialized>
  baseline_ref:
    baseline_id: <platform-baseline-id>
    artifact_ref:
      ref_version: v2
      artifact_id: <platform-baseline-artifact-id>
      version: <platform-baseline-version>
      repository_url: <https://github.com/org/platform-repo>
      repository_entrypoint: <PLATFORM.md>
      artifact_path: <architecture/platforms/platform-id/platform-design.yml>
      commit_sha: <full-40-or-64-character-commit>
      digest: <sha256:64-hex-digest>
  # baseline_absence_reason: <why-no-accepted-platform-baseline-exists>
requested_delta:
  requirements:
    add: [<stable-requirement-id>]
  architecture_elements:
    use: [<interface-id-or-connection-id>]
    add: [<connection-id>]
    change: []
    retire: []
acceptance_criteria:
  - criterion_id: <stable-criterion-id>
    statement: <testable-platform-acceptance-statement>
external_refs: []
