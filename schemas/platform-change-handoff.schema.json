{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/enterprise.md/schemas/platform-change-handoff.schema.json",
  "title": "platform-change-handoff.yml",
  "description": "Portable immutable Solution Architecture to Platform requested-change contract for one Workstream. Runtime lifecycle and realization evidence are excluded.",
  "type": "object",
  "required": ["spec_name", "spec_version", "workstream_id", "initiative_id", "solution_design_ref", "target", "requested_delta", "acceptance_criteria"],
  "properties": {
    "spec_name": {"const": "platform-change-handoff"},
    "spec_version": {"type": "string", "pattern": "^1\\.\\d+\\.\\d+$"},
    "workstream_id": {"$ref": "#/$defs/identifier"},
    "initiative_id": {"$ref": "#/$defs/identifier"},
    "solution_design_ref": {"$ref": "#/$defs/artifactRef"},
    "target": {"$ref": "#/$defs/platformTarget"},
    "requested_delta": {"$ref": "#/$defs/requestedDelta"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "external_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "artifactRef": {
      "type": "object",
      "required": ["ref_version", "artifact_id", "version", "repository_url", "repository_entrypoint", "artifact_path", "commit_sha", "digest"],
      "properties": {
        "ref_version": {"const": "v2"},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1},
        "repository_url": {"type": "string", "format": "uri", "minLength": 1},
        "repository_entrypoint": {"$ref": "#/$defs/repoPath"},
        "artifact_path": {"$ref": "#/$defs/repoPath"},
        "commit_sha": {"$ref": "#/$defs/commit"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "baselineRef": {
      "type": "object",
      "required": ["baseline_id", "artifact_ref"],
      "properties": {
        "baseline_id": {"$ref": "#/$defs/identifier"},
        "artifact_ref": {"$ref": "#/$defs/artifactRef"}
      },
      "additionalProperties": false
    },
    "platformTarget": {
      "type": "object",
      "required": ["kind", "platform_id", "baseline_state"],
      "properties": {
        "kind": {"const": "platform"},
        "platform_id": {"$ref": "#/$defs/identifier"},
        "baseline_state": {"enum": ["existing", "not_materialized"]},
        "baseline_ref": {"$ref": "#/$defs/baselineRef"},
        "baseline_absence_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"baseline_state": {"const": "existing"}}, "required": ["baseline_state"]}, "then": {"required": ["baseline_ref"], "not": {"required": ["baseline_absence_reason"]}}},
        {"if": {"properties": {"baseline_state": {"const": "not_materialized"}}, "required": ["baseline_state"]}, "then": {"required": ["baseline_absence_reason"], "not": {"required": ["baseline_ref"]}}}
      ],
      "additionalProperties": false
    },
    "deltaSet": {
      "type": "object",
      "properties": {
        "use": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "add": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "change": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "retire": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "requestedDelta": {
      "type": "object",
      "properties": {
        "requirements": {"$ref": "#/$defs/deltaSet"},
        "architecture_elements": {"$ref": "#/$defs/deltaSet"}
      },
      "minProperties": 1,
      "anyOf": [
        {"$ref": "#/$defs/nonEmptyRequirementDelta"},
        {"$ref": "#/$defs/nonEmptyArchitectureDelta"}
      ],
      "additionalProperties": false
    },
    "nonEmptyRequirementDelta": {
      "type": "object",
      "required": ["requirements"],
      "properties": {
        "requirements": {
          "type": "object",
          "anyOf": [
            {"required": ["use"], "properties": {"use": {"minItems": 1}}},
            {"required": ["add"], "properties": {"add": {"minItems": 1}}},
            {"required": ["change"], "properties": {"change": {"minItems": 1}}},
            {"required": ["retire"], "properties": {"retire": {"minItems": 1}}}
          ]
        }
      }
    },
    "nonEmptyArchitectureDelta": {
      "type": "object",
      "required": ["architecture_elements"],
      "properties": {
        "architecture_elements": {
          "type": "object",
          "anyOf": [
            {"required": ["use"], "properties": {"use": {"minItems": 1}}},
            {"required": ["add"], "properties": {"add": {"minItems": 1}}},
            {"required": ["change"], "properties": {"change": {"minItems": 1}}},
            {"required": ["retire"], "properties": {"retire": {"minItems": 1}}}
          ]
        }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["criterion_id", "statement"],
      "properties": {
        "criterion_id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
