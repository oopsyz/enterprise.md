{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/enterprise.md/schemas/domain-change-handoff.schema.json",
  "title": "domain-change-handoff.yml",
  "description": "Portable, immutable Solution Architecture to Domain Architecture requested-change contract for one Workstream. Runtime lifecycle, decisions, gates, and realization evidence are intentionally excluded.",
  "type": "object",
  "required": [
    "spec_name",
    "spec_version",
    "workstream_id",
    "initiative_id",
    "solution_design_ref",
    "target",
    "requested_delta",
    "acceptance_criteria"
  ],
  "properties": {
    "spec_name": {
      "const": "domain-change-handoff"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "workstream_id": {
      "$ref": "#/$defs/identifier"
    },
    "initiative_id": {
      "$ref": "#/$defs/identifier"
    },
    "solution_design_ref": {
      "$ref": "#/$defs/artifactRefV2"
    },
    "target": {
      "$ref": "#/$defs/domainTarget"
    },
    "requested_delta": {
      "$ref": "#/$defs/requestedDelta"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "external_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalRef"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "artifactRefV2": {
      "type": "object",
      "required": [
        "ref_version",
        "artifact_id",
        "version",
        "repository_url",
        "repository_entrypoint",
        "artifact_path",
        "commit_sha",
        "digest"
      ],
      "properties": {
        "ref_version": {
          "const": "v2"
        },
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "repository_entrypoint": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "artifact_path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "commit_sha": {
          "$ref": "#/$defs/commitSha"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      },
      "additionalProperties": false
    },
    "baselineRef": {
      "type": "object",
      "required": ["baseline_id", "artifact_ref"],
      "properties": {
        "baseline_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_ref": {
          "$ref": "#/$defs/artifactRefV2"
        }
      },
      "additionalProperties": false
    },
    "domainTarget": {
      "type": "object",
      "required": ["kind", "domain_id", "baseline_state"],
      "properties": {
        "kind": {
          "const": "domain"
        },
        "domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "baseline_state": {
          "enum": ["existing", "not_materialized"]
        },
        "baseline_ref": {
          "$ref": "#/$defs/baselineRef"
        },
        "baseline_absence_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"baseline_state": {"const": "existing"}},
            "required": ["baseline_state"]
          },
          "then": {
            "required": ["baseline_ref"],
            "not": {"required": ["baseline_absence_reason"]}
          }
        },
        {
          "if": {
            "properties": {"baseline_state": {"const": "not_materialized"}},
            "required": ["baseline_state"]
          },
          "then": {
            "required": ["baseline_absence_reason"],
            "not": {"required": ["baseline_ref"]}
          }
        }
      ],
      "additionalProperties": false
    },
    "deltaSet": {
      "type": "object",
      "properties": {
        "use": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "add": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "change": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "retire": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "requestedDelta": {
      "type": "object",
      "properties": {
        "requirements": {
          "$ref": "#/$defs/deltaSet"
        },
        "architecture_elements": {
          "$ref": "#/$defs/deltaSet"
        }
      },
      "minProperties": 1,
      "anyOf": [
        {"$ref": "#/$defs/nonEmptyRequirementDelta"},
        {"$ref": "#/$defs/nonEmptyArchitectureDelta"}
      ],
      "additionalProperties": false
    },
    "nonEmptyRequirementDelta": {
      "type": "object",
      "required": ["requirements"],
      "properties": {
        "requirements": {
          "type": "object",
          "anyOf": [
            {"required": ["use"], "properties": {"use": {"minItems": 1}}},
            {"required": ["add"], "properties": {"add": {"minItems": 1}}},
            {"required": ["change"], "properties": {"change": {"minItems": 1}}},
            {"required": ["retire"], "properties": {"retire": {"minItems": 1}}}
          ]
        }
      }
    },
    "nonEmptyArchitectureDelta": {
      "type": "object",
      "required": ["architecture_elements"],
      "properties": {
        "architecture_elements": {
          "type": "object",
          "anyOf": [
            {"required": ["use"], "properties": {"use": {"minItems": 1}}},
            {"required": ["add"], "properties": {"add": {"minItems": 1}}},
            {"required": ["change"], "properties": {"change": {"minItems": 1}}},
            {"required": ["retire"], "properties": {"retire": {"minItems": 1}}}
          ]
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "required": ["criterion_id", "statement"],
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "externalRef": {
      "type": "object",
      "required": ["system", "id"],
      "properties": {
        "system": {
          "$ref": "#/$defs/identifier"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
